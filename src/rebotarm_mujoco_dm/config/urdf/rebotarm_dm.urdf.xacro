<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="ReBot_Arm_DM">
  <xacro:arg name="initial_positions_file" default="$(find rebotarm_moveit_config)/config/initial_positions.yaml"/>
  <xacro:arg name="mujoco_scene_path" default=""/>
  <xacro:arg name="headless" default="false"/>
  <xacro:include filename="$(find rebotarm_bringup)/description/DM/urdf/ReBot_Arm_DM.urdf"/>
  <xacro:include filename="$(find rebotarm_mujoco_dm)/config/rebotarm_mujoco_dm.ros2_control.xacro"/>
  <link name="gripper_tcp"/>
  <joint name="gripper_tcp_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0"/>
    <parent link="end_link"/>
    <child link="gripper_tcp"/>
  </joint>
  <xacro:rebotarm_mujoco_dm_ros2_control name="RebotArmMujocoDMSystem"
    initial_positions_file="$(arg initial_positions_file)"
    mujoco_scene_path="$(arg mujoco_scene_path)" headless="$(arg headless)"/>
</robot>
